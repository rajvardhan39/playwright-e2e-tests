

{
    "compilerOptions": {
         "types": ["node", "@playwright/test"],
        "target": "ESNext",
        "module": "CommonJS",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": false,
        "noImplicitAny": false
    },
    "include": [
        "test/**/*.ts",
        "data/**/*.ts",
        "playwright.config.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
